{
  "name": "zeno",
  "version": "2.0.1",
  "description": "ZENO, the ultimate personal AI system by Team ZAP",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "dev.zap.zeno",
    "productName": "ZENO",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "overlay.html",
      "lib/**",
      "css/**",
      "js/**",
      "plugins/**",
      "assets/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "artifactName": "ZENO-Setup-${version}.exe"
    },
    "portable": {
      "splashImage": "build/splash.bmp",
      "artifactName": "ZENO-portable-${version}.exe"
    }
  },
  "author": "Zap",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3"
  }
}
